# Environment Configuration for Forecast Service
# Copy this to .env and update values as needed

# ===== Server Configuration =====
# Host to bind to (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Port to run on (Railway assigns this automatically, but 8000 for local)
PORT=8000

# Environment mode: development or production
ENVIRONMENT=development

# ===== CORS Configuration =====
# Comma-separated list of allowed origins for frontend requests
# Local: http://localhost:5173,http://localhost:3000
# Production: https://your-app.vercel.app,https://api.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# ===== Logging =====
# Log level: debug, info, warning, error
LOG_LEVEL=info
